# Neon Postgres connection string (Vercel Marketplace: vercel integration add neon)
DATABASE_URL=

# Signed session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: force demo users even when DATABASE_URL is set
# SEED_DEMO=true

# Optional: override local PGlite directory
# PGLITE_DATA_DIR=.data/job-command
